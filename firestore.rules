rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }

    function isValidEnquiry(data) {
      return data.keys().hasAll(['name', 'company', 'country', 'phone', 'email', 'projectType', 'message', 'createdAt'])
        && data.name is string && data.name.size() <= 100
        && data.company is string && data.company.size() <= 100
        && data.country is string && data.country.size() <= 100
        && data.phone is string && data.phone.size() <= 30
        && data.email is string && data.email.size() <= 100
        && data.projectType is string && data.projectType.size() <= 100
        && data.message is string && data.message.size() <= 5000
        && data.createdAt == request.time
        && (
          !('budget' in data) || (data.budget is string && data.budget.size() <= 100)
        )
        && (
          !('timeline' in data) || (data.timeline is string && data.timeline.size() <= 100)
        )
        && (
          !('attachmentUrl' in data) || (data.attachmentUrl is string && data.attachmentUrl.size() <= 1000)
        );
    }

    function isValidApplication(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'role', 'createdAt'])
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.phone is string && data.phone.size() <= 30
        && data.role is string && data.role.size() <= 100
        && data.createdAt == request.time
        && (
          !('cvUrl' in data) || (data.cvUrl is string && data.cvUrl.size() <= 1000)
        )
        && (
          !('coverNote' in data) || (data.coverNote is string && data.coverNote.size() <= 5000)
        );
    }

    match /enquiries/{enquiryId} {
      // Anyone can create an enquiry
      allow create: if isValidId(enquiryId) && isValidEnquiry(incoming());
      // No one can read, update, or delete (except admin via console)
    }

    match /applications/{applicationId} {
      // Anyone can create an application
      allow create: if isValidId(applicationId) && isValidApplication(incoming());
      // No one can read, update, or delete (except admin via console)
    }
  }
}
